package com.example.taller14;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
    Scanner teclado = new Scanner(System.in);
    
    int total_seg, horas, minutos, segund, sobrante;  
    
    System.out.println("digite el tiempo total en segundos");
    total_seg =teclado.nextInt();
    
    horas = total_seg/3600;
    sobrante = total_seg%3600;
    
    minutos = sobrante/ 60;
    segund = sobrante%60;
    
    System.out.println("--------------");
    System.out.println("el tiempo en segundos expresado en horas, minutos y segundos es:");
    System.out.println("horas:" +horas);
    System.out.println("minutos:"+ minutos);
    System.out.println("segundos:"+ segund);
        
    }
}
